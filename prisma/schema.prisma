  new_values        Json?
  ip_address        String?  @db.Inet
  user_agent        String?
  registration_date DateTime @default(now()) @db.Timestamptz(6)
  users             users?   @relation(fields: [fk_user], references: [user_id], map: "fk_audit_log_user")

  @@index([registration_date(sort: Desc)], map: "idx_audit_log_date")
  @@index([entity_name, entity_id], map: "idx_audit_log_entity")
  @@index([fk_user], map: "idx_audit_log_user")
}

