model Team {
  teamId                                       Int                   @id(map: "pk_team") @default(autoincrement()) @map("team_id")
  name                                         String                @unique(map: "uk_team_name") @db.VarChar(150)
  shortName                                    String?               @unique(map: "uk_team_short_name") @map("short_name") @db.VarChar(50)
  status                                       Boolean               @default(true)
  registrationDate                             DateTime              @default(now()) @map("registration_date") @db.Timestamptz(6)
  updateDate                                   DateTime?             @updatedAt @map("update_date") @db.Timestamptz(6)
  code                                         String?               @unique(map: "uk_team_code", where: raw("(code IS NOT NULL)")) @db.VarChar(30)
  logoUrl                                      String?               @map("logo_url")
  primaryColor                                 String?               @map("primary_color") @db.VarChar(20)
  secondaryColor                               String?               @map("secondary_color") @db.VarChar(20)
  foundationDate                               DateTime?             @map("foundation_date") @db.Date
  description                                  String?               @db.VarChar(500)
  fkHomeField                                  Int?                  @map("fk_home_field")
  delegate_team                                delegate_team?
  gallery_album                                gallery_album[]
  match_event                                  match_event[]
  match_lineup                                 match_lineup[]
  payment                                      payment[]
  player                                       player[]
  soccer_match_soccer_match_fk_away_teamToteam soccer_match[]        @relation("soccer_match_fk_away_teamToteam")
  soccer_match_soccer_match_fk_home_teamToteam soccer_match[]        @relation("soccer_match_fk_home_teamToteam")
  field                                        field?                @relation(fields: [fkHomeField], references: [field_id], map: "fk_team_home_field")
  team_coach                                   team_coach[]
  tournament_standing                          tournament_standing[]
  tournament_team                              tournament_team[]

  @@index([fkHomeField], map: "idx_team_home_field")
  @@index([status], map: "idx_team_status")
  @@map("team")
}

model audit_log {
  audit_log_id      BigInt   @id(map: "pk_audit_log") @default(autoincrement())
  fk_user           Int?
  action            String   @db.VarChar(30)
